# Variables de entorno de Next.js. Solo las que empiezan con NEXT_PUBLIC_ llegan al navegador.
# No pongas claves secretas en una variable NEXT_PUBLIC_: cualquiera puede verlas.
# Si cambiás este archivo, reiniciá "npm run dev".

# Dirección de la API: Django, FastAPI o Express (sin barra al final).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
