# Configuración local del proyecto.
# - .env.example es la plantilla: se sube a git y no tiene datos privados.
# - .env tiene los valores reales de tu PC y NO se sube a git.
# Si te falta el .env, copiá .env.example con el nombre .env.

# Puerto de la API. 8000, como Django y FastAPI: React y React Native ya apuntan ahí.
PORT=8000

# Base de datos SQLite: el archivo datos.db en la carpeta del proyecto.
DATABASE_URL=file:./datos.db

# Páginas web que pueden usar la API: Vite (React), Next.js y Expo web.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8081

# Zona horaria de las fechas con hora. Si no se define, America/Argentina/Salta.
# ZONA_HORARIA=America/Argentina/Salta
