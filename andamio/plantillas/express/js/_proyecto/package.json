{
  "name": "@@proyecto@@",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "tsx watch src/servidor.js",
    "start": "tsx src/servidor.js",
    "pretest": "node --eval \"require('node:fs').rmSync('test.db', { force: true })\" && prisma generate && prisma db push --url file:./test.db",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
