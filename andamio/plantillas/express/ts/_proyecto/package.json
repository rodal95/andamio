{
  "name": "@@proyecto@@",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "tsx watch src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "pretest": "node --eval \"require('node:fs').rmSync('test.db', { force: true })\" && prisma generate && prisma db push --url file:./test.db",
    "test": "tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "tipos": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "jose": "6.2.15",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/swagger-ui-express": "4.1.8",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
