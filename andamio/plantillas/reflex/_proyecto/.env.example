# Configuración local del proyecto.
# - .env.example es la plantilla: se sube a git y no tiene datos privados.
# - .env tiene los valores reales de tu PC y NO se sube a git.

# Dirección de la API que usan las páginas hechas con "crud-api" y los servicios:
# Django, FastAPI o Express hechos con andamio (sin barra al final).
API_URL=http://localhost:8000/api
