# Configuración local del proyecto.
# - .env.example es la plantilla: se sube a git y no tiene datos privados.
# - .env tiene los valores reales de tu PC y NO se sube a git.
# Si te falta el .env, copiá .env.example con el nombre .env.

# Clave secreta de Django. En un servidor real tiene que ser larga y privada.
SECRET_KEY=@@secret_key@@

# True para desarrollar (muestra errores detallados). En un servidor, False.
DEBUG=True

# Nombres con los que se puede acceder al sitio (separados por coma).
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Si no se define, se usa SQLite (db.sqlite3).
# DATABASE_URL=postgres://usuario:clave@localhost:5432/mi_base
