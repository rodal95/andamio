# Variables de entorno. Next.js las lee solo; las que empiezan con NEXT_PUBLIC_ llegan
# también al navegador (no pongas claves secretas en ellas).
# Si cambiás este archivo, reiniciá "npm run dev".

# Base de datos SQLite: el archivo datos.db en la carpeta del proyecto.
DATABASE_URL=file:./datos.db

# Dirección de la API que usan las páginas. Sin definir, es la de este proyecto (/api).
# NEXT_PUBLIC_API_URL=/api

# Otras páginas que pueden usar la API de este proyecto (por ejemplo, React con Vite o Expo web).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Zona horaria de las fechas con hora. Si no se define, America/Argentina/Salta.
# ZONA_HORARIA=America/Argentina/Salta
